{% extends 'layouts/base.admin.html.twig' %}

{% block title %}
	Famms | BackOffice | Articles
{% endblock %}

{% block body %}

	<section class="section is-title-bar">
		<div class="level">
			<div class="level-left">
				<div class="level-item">
					<ul>
						<li>BackOffice</li>
						<li>Articles</li>
					</ul>
				</div>
			</div>
			<div class="level-right">
				<a href="{{ path('app_admin_product_add') }}" class="button is-small is-primary" type="button">
					<span>Ajouter</span>
					<span class="icon">
						<i class="mdi mdi-plus"></i>
					</span>
				</a>
			</div>
		</div>
	</section>
	<section class="section is-main-section">

		{% for label, messages in app.flashes(['success', 'danger']) %}
			{% for message in messages %}
				<div class="notification is-{{ label }}">
					<button class="delete"></button>
					{{ message }}
				</div>
			{% endfor %}
		{% endfor %}

		<div class="card has-table">
			<header class="card-header">
				<p class="card-header-title">
					<span class="icon">
						<span class="mdi mdi-shopping-outline"></span>
					</span>
					{{ dataProducts|length }}
					articles
				</p>
				<a href="#" class="card-header-icon">
					<span class="icon">
						<i class="mdi mdi-reload"></i>
					</span>
				</a>
			</header>
			<div class="card-content">
				<div class="b-table has-pagination">
					<div class="table-wrapper has-mobile-cards">
						<table class="table is-fullwidth is-striped is-hoverable is-fullwidth" id="table">
							<thead>
								<tr>
									<th>Photo</th>
									<th>Titre</th>
									<th>Description</th>
									<th>Référence</th>
									<th>Catégorie</th>
									<th>Taille</th>
									<th>Couleur</th>
									<th>Genre</th>
									<th>Prix</th>
									<th>Stock</th>
									<th>Enregistré le</th>
                                    <th></th>
								</tr>
							</thead>
							<tbody>
								{% for item in dataProducts %}
									<tr>
										<td data-label="Photo" class="">
											<img src="{{ asset('uploads/photos/' ~ item.picture) }}" alt="{{ item.name }}" class="">
										</td>
										<td data-label="Titre">{{ item.name }}</td>
										<td data-label="Description">{{ item.description|slice(0, 40) }}[...]</td>
										<td data-label="Référence">{{ item.reference }}</td>
										<td data-label="Categorie">{{ item.category.name }}</td>
										<td data-label="Taille">{{ item.size }}</td>
										<td data-label="Couleur">{{ item.color }}</td>
										<td data-label="Genre">{{ item.gender }}</td>
										<td data-label="Prix">{{ item.price }}€</td>
										<td data-label="Stock">{{ item.stock }}</td>
										<td data-label="Enregistré le">
											<small class="has-text-grey is-abbr-like" title="{{ item.createdAT|date('d/m/Y') }}">{{ item.createdAT|date('d/m/Y') }}</small>
										</td>
										<td class="is-actions-cell">
											<div class="buttons is-right">
												<a href="{{ path('app_admin_product_update', {'id': item.id}) }}" class="button is-small is-primary" type="button">
													<span class="icon">
														<i class="mdi mdi-pencil"></i>
													</span>
												</a>
												<button class="button is-small is-danger jb-modal" data-target="sample-modal-{{ item.id }}" type="button">
													<span class="icon">
														<i class="mdi mdi-trash-can"></i>
													</span>
												</button>
											</div>
										</td>
									</tr>

									<div id="sample-modal-{{ item.id }}" class="modal">
										<div class="modal-background jb-modal-close"></div>
										<div class="modal-card">
											<header class="modal-card-head">
												<p class="modal-card-title">Confimer la suppression</p>
												<button class="delete jb-modal-close" aria-label="close"></button>
											</header>
											<section class="modal-card-body">
												<p>Voulez-vous réellement supprimer la catégorie ?</p>
											</section>
											<footer class="modal-card-foot">
												<button class="button jb-modal-close">Annuler</button>
												<a href="{{ path('app_admin_category_remove', {'id': item.id}) }}" class="button is-danger jb-modal-close">Supprimer</a>
											</footer>
										</div>
										<button class="modal-close is-large jb-modal-close" aria-label="close"></button>
									</div>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</section>

{% endblock %}
